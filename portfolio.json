            "copy_heading": "Bricolage Human Capital",
            "link_internal": null,
            "cta_text": "Website link",
            "image": "/media/bricolage-hero.webp",
            "include_cta": "none",
            "copy": "This initiative focused on revamping BHC's website to ensure it reflects the company's identity more accurately while also establishing an accessible point of contact for service inquiries.",
            "link_external": "https://bricolagehumancapital.co.ke",
            "link_internal_type": null,
            "image_alt": "chartske website",
            "caption_position": null,
            "caption": null,
            "image_is_decorative": true,
            "include_caption": false,
