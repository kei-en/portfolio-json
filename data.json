        "meta_description": "A working discovery platform with categorized browsing, random site serving, and a community submission pipeline.",
        "meta_image": "/websurfer-hero.webp",
        "meta_title": "Websurfer",
        "title": "Websurfer",
        "intro": null,
        "slug": "websurfer",
        "content": [
          {
            "_type": "project_text",
            "copy": "Sparked by personally rediscovering forgotten bookmarked sites, the project reframes browsing as discovery — a platform for surfacing weird, quirky, and genuinely interesting corners of the internet that don't surface through mainstream algorithms. Positioned as an alternative to algorithm-driven doomscrolling.",
            "cta_text": null,
            "heading": "The Idea",
            "include_cta": "none",
            "link_external": null,
            "link_file": null,
            "link_internal": null,
            "link_internal_type": null
          },
          {
            "_type": "project_text",
            "copy": "Sites are embedded directly on the platform where possible (external links open in a new tab where embedding isn't feasible), organized into categories, and served randomly. Users click through with a 'next' button and can switch categories anytime. A submission form lets users contribute sites they've found, which are vetted against clear inclusion guidelines before going live.",
            "cta_text": null,
            "heading": "How it works",
            "include_cta": "none",
            "link_external": null,
            "link_file": null,
            "link_internal": null,
            "link_internal_type": null
